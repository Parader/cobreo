# Site
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_ADMIN_PATH_SECRET=change-me

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# New API keys (recommended):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy aliases still supported:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Email (Resend)
# 1) Restart `npm run dev` after any .env change — Next only loads env at boot.
# 2) With onboarding@resend.dev you can ONLY send to the Resend account email.
# 3) Verify your domain at https://resend.com/domains, then set RESEND_FROM_EMAIL
#    to an address on that domain, e.g. Cobreo <hello@your-domain.com>
RESEND_API_KEY=
RESEND_FROM_EMAIL=Cobreo <hello@your-domain.com>
CONTACT_NOTIFY_EMAIL=notify@your-domain.com
BOOKING_ORGANIZER_EMAIL=organizer@your-domain.com

# Google Meet — reusable room (created in personal Gmail is fine).
# Host admission is configured in Meet host controls, not here.
BOOKING_MEET_LINK=https://meet.google.com/xxx-xxxx-xxx

# Analytics (optional)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=
# Personal API key (Project settings → Personal API keys) — powers the admin Analytics tab.
# POSTHOG_PERSONAL_API_KEY=phx_...
# POSTHOG_PROJECT_ID=561368

# Twenty CRM (self-hosted). Site writes still succeed if these are empty.
# TWENTY_API_URL=https://crm.cobreo.ca
# TWENTY_API_KEY=
# Cloudflare Access service token so Netlify can call the API through Access.
# TWENTY_CF_ACCESS_CLIENT_ID=
# TWENTY_CF_ACCESS_CLIENT_SECRET=
