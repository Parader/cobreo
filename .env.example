# Site
NEXT_PUBLIC_SITE_URL=https://cobreo.ca
NEXT_PUBLIC_ADMIN_PATH_SECRET=ops-cobreo

# Supabase — projet Cobreo
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# New API keys (recommended):
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
# Legacy aliases still supported:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Email (Resend)
# 1) Restart `npm run dev` after any .env change — Next only loads env at boot.
# 2) With onboarding@resend.dev you can ONLY send to the Resend account email.
# 3) To email prospects + contact@cobreo.ca: verify cobreo.ca at https://resend.com/domains
#    then set RESEND_FROM_EMAIL to an address on that domain, e.g. Cobreo <contact@cobreo.ca>
RESEND_API_KEY=
RESEND_FROM_EMAIL=Cobreo <derick@cobreo.ca>
CONTACT_NOTIFY_EMAIL=contact@cobreo.ca
BOOKING_ORGANIZER_EMAIL=derick@cobreo.ca

# Google Meet — reusable room (created in personal Gmail is fine).
# Host admission is configured in Meet host controls, not here.
BOOKING_MEET_LINK=https://meet.google.com/xxx-xxxx-xxx
