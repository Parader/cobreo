  "ranking": {
    "model": "opportunity_ranking_not_stage_average",
    "conceptual_formula": "problem_strength * consequence_relevance * confidence",
    "problem_strength_inputs": [
      "importance",
      "consequences",
      "signal_convergence"
    ],
    "confidence_inputs": [
      "importance_answered",
      "consequence_answered",
      "cause_known_when_needed",
      "signal_convergence"
    ],
    "bonuses": [
      "multiple_converging_signals",
      "same_friction_across_dimensions",
      "multiple_material_consequences"
    ],
    "prohibited_positive_signals": [
      "manual_process_alone",
      "multiple_tools_alone",
      "multiple_channels_alone",
      "spreadsheet_use_alone"
    ],
    "output_levels": [
      "watch",
      "possible",
      "clear"
    ],
    "max_prospect_opportunities": 3
  },
  "result_generation": {
    "prospect": {
      "sections": [
        "what_we_noticed",
        "opportunities",
        "potential_gain",
        "why"
      ],
      "traceability_required": true,
      "gain_levels": [
        "low",
        "moderate",
        "important"
      ],
      "rules": [
        "Never infer a consequence not selected or otherwise supported by answers.",
        "Never jump directly from friction to custom software.",
        "Use improvement verbs before solution categories.",
        "Only describe dimensions actually explored.",
        "Allow healthy/no-opportunity result.",
        "Allow too-early-for-intervention result.",
        "Never mention the questionnaire, diagnostic engine, or meeting as part of the analytical result.",
        "Do not use phrases such as 'Le questionnaire détecte', 'Cette analyse a identifié', or 'La rencontre permet de comprendre et de prioriser'.",
        "Keep commercial CTA visually and semantically separate from analysis."
      ]
    },
    "internal": {
      "fields": [
        "responses",
        "signals",
        "potential_problems",
        "opportunities",
        "confidence",
        "missing_information",
        "meeting_questions",
        "problem_potential",
        "technical_constraints",
        "must_keep_systems",
        "taxonomy_gap_candidates"
      ]
    },
    "healthy_result": {
      "trigger": "no_opportunity_meets_minimum_threshold",
      "message_fr": "Nous n'avons pas repéré de friction importante dans les dimensions que vous avez explorées. Certaines façons de faire manuelles ou simples fonctionnent très bien lorsqu'elles demandent peu d'effort et causent peu de problèmes."
    },
    "early_stage_result": {
      "trigger": "context_business_situation == 'starting' and low_applicability and low_friction",
      "message_fr": "Votre activité semble encore assez simple pour que plusieurs processus puissent rester légers. Il n'est probablement pas utile de structurer ou automatiser davantage pour l'instant."
    }
  },
